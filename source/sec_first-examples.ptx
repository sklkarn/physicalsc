<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec_first-examples" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Examples</title>
  
    <example>
    <statement>
      <p>
        Write the sum of the numbers <m>362.50, 273.2,</m> and <m>0.502 </m> in a proper significant figures.
      </p>
    </statement>
    <solution>
      <p>
        The mathematical sum of the numbers is <m>636.202</m>
        but, the lowest decimal place in the data is one, hence 
        the correct answer would be <m>636.2</m>
      </p>
    </solution>
  </example>

  <example>
    <statement>
      <p>
        Write the numbers in correct to its significant figures if <m>0.502 </m> is subtracted from <m>362.50</m>.
      </p>
    </statement>
    <solution>
      <p>
        The mathematical subtraction is <m>361.998</m>
        but, the lowest decimal place in the data is two, hence 
        the correct answer would be <m>362.00.</m>
      </p>
    </solution>
  </example>


  <example>
    <p>
      Round off the numbers <m>2.572, \, 2.566,</m> and <m>2.725</m> to the three significant figures.
    </p>
    <answer>
      <p>
       <m> 2.57, \, 2.57, \, 2.73\, (or, 2.72).</m>
      </p>
    </answer>
  </example>

  <example>
    <p>
      Round off the numbers <m>2052, \, 8566,</m> and <m>5725</m> to the two significant figures.
    </p>
    <answer>
      <p>
       <m> 2100\, (or, 2000), \, 8600, \, 5700.</m>
      </p>
    </answer>
  </example>

  <example>
    <statement>
      <p>
        Write the answer for each expression using scientific notation with the appropriate number of significant
figures.
        <ol marker ="a.">
          <li><m>217 \div 903</m></li>  
            <li><m>38.65\times105.74</m></li>    
            <li><m>125\times9.000</m></li>
              <li><m>13.77 + 908.226 + 515</m></li>
                <li><m>255.0 - 99</m></li>
                  <li><m>0.00666 \times 321</m></li>
        </ol>
      </p>
    </statement>
    <solution>
      <p>
       <ol marker ="a.">
          <li><m>0.240</m></li>  
            <li><m>4087</m></li>    
            <li><m>113</m></li>
              <li><m>1440</m></li>
                <li><m>160</m></li>
                  <li><m>2.14</m></li>
        </ol>
      </p>
    </solution>
  </example>


  <example>
    <statement>
      <p> What is the SI unit for measuring temperature?
        <ol marker ="a.">
          <li>Kelvin</li>  
            <li>Degree Celsius</li>    
            <li>Fahrenheit</li>
              <li>Rankine</li>
        </ol>  
      </p>
    </statement>
    <solution>
      <p>
        a.
      </p>
    </solution>
  </example>


  <example>
    <statement>
      <p> What is the SI unit for measuring length?
        <ol marker ="a.">
          <li>Kelvin</li>  
            <li>Second</li>    
            <li>Meter</li>
              <li>Kilogram</li>
        </ol>  
      </p>
    </statement>
    <solution>
      <p>
        c.
      </p>
    </solution>
  </example>


  <example>
      <p> What is the SI unit for measuring time?
        <ol marker ="a.">
          <li>Meter</li>  
            <li>Kilogram</li>    
            <li>Second</li>
              <li>Watt</li>
        </ol>  
      </p>
  </example>


  <example>
    <p> What is the conversion factor for converting centimeters to inch?
      <ol marker ="a.">
        <li>2.54</li>  
          <li>100</li>    
          <li>10</li>
            <li>25.4</li>
      </ol>  
    </p>
    <answer>
      <p>
        a.
      </p>
    </answer>
</example>

<paragraphs>
  <title>Math Practice</title>
  

<sage>
  <input>
  4 / 2.0
  </input>
  <output>
  2.0
  </output>
  </sage>

  <sage>
    <input>
    1 / 4.0
    </input>
    <output>
    0.25
    </output>
    </sage>

    <sage>
      <input>
      2*4
      </input>
      <output>
      8
      </output>
      </sage>

      <sage>
        <input>
        2 + 4 - 2
        </input>
        <output>
        4
        </output>
        </sage>

        <sage>
          <input>
            14//4
          </input>
          <output>
            3
          </output>
        </sage>
        
        <sage>
          <input>
            14%4
          </input>
          <output>
            2
          </output>
        </sage>
        
        <sage>
          <input>
            2^5
          </input>
          <output>
            32
          </output>
        </sage>

        <sage>
          <input>
           divmod(14,4) 
          </input>
          <output>
            (3,2)
          </output>
        </sage>
        
        <sage>
          <input>
            8^(1/3)
          </input>
          <output>
            2
          </output>
        </sage>
        
        <sage>
          <input>
            solve(x^2+x ==6,x)
          </input>
          <output>
            [x == -3, x == 2]
          </output>
        </sage>
               
      </paragraphs>
</section>

