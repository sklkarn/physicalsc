        <ol marker ="a">
          <li>Caribbean Sea.</li>
          <li>  Red Sea. </li>
            <li> Tethys Sea.</li>
           <li>Dead Sea.</li>
          </ol>
      </p>
    </statement>
    <solution>
      <p>
        c.
      </p>
    </solution>
